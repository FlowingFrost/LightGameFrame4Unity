:root {
    -unity-font: resource('Fonts/SourceHanSansSC-Normal');
    -unity-font-definition: resource('Fonts/SourceHanSansSC-Normal SDF');
    --font-title: 60px;
    --font-desc: 30px;
    --font-btn: 30px;
    --font-detail: 30px;
}

/* === Root Scroll === */
.root-scroll {
    flex-grow: 1;
}

/* === Root === */
.root {
    background-color: rgb(42, 42, 46);
    padding: 24px;
}

/* === Header === */
.header {
    align-items: center;
    padding-bottom: 16px;
    border-bottom: 1px solid rgb(62, 62, 66);
    margin-bottom: 16px;
}

.title {
    -unity-font-style: bold;
    font-size: var(--font-title);
    color: rgb(200, 200, 200);
    -unity-text-align: middle-center;
}

.title-warning {
    color: rgb(255, 152, 0);
    animation-name: pulse;
    animation-duration: 2s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
}

/* === Content === */
.content {
    flex-grow: 1;
}

.description {
    font-size: var(--font-desc);
    color: rgb(200, 200, 200);
    white-space: normal;
    margin-bottom: 20px;
    -unity-text-align: middle-center;
}

/* === Buttons === */
.button-group {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}

.btn {
    margin-left: 8px;
    margin-right: 8px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 10px;
    padding-bottom: 10px;
    font-size: var(--font-btn);
    border-radius: 4px;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.btn-primary {
    background-color: rgb(74, 158, 255);
    color: rgb(255, 255, 255);
    animation-name: glow;
    animation-duration: 2s;
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
}

.btn-primary:hover {
    background-color: rgb(107, 179, 255);
}

.btn-secondary {
    background-color: rgb(62, 62, 66);
    color: rgb(200, 200, 200);
}

.btn-secondary:hover {
    background-color: rgb(78, 78, 82);
}

/* === Error Detail === */
.error-detail {
    font-size: var(--font-detail);
    color: rgb(244, 135, 113);
    white-space: normal;
    background-color: rgb(30, 30, 30);
    border-radius: 4px;
    padding: 12px;
    margin-top: 8px;
}

/* === Keyframes === */
@keyframes pulse {
    0%   { opacity: 1; }
    50%  { opacity: 0.6; }
    100% { opacity: 1; }
}

@keyframes glow {
    0%   { background-color: rgb(74, 158, 255); }
    50%  { background-color: rgb(107, 179, 255); }
    100% { background-color: rgb(74, 158, 255); }
}
